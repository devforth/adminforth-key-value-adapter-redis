{
  "name": "@adminforth/key-value-adapter-redis",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc"
  },
  "keywords": [],
  "author": "DevForth (https://devforth.io)",
  "license": "MIT",
  "description": "AdminForth key-value adapter backed by Redis.",
  "devDependencies": {
    "adminforth": "^4.7.3",
    "semantic-release": "^24.2.1",
    "semantic-release-slack-bot": "^4.0.2"
  },
  "dependencies": {
    "file-type": "^20.5.0",
    "redis": "^5.10.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "adminforth": "^3.0.1"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "semantic-release-slack-bot",
        {
          "packageName": "@adminforth/key-value-adapter-redis",
          "notifyOnSuccess": true,
          "notifyOnFail": true,
          "slackIcon": ":package:",
          "markdownReleaseNotes": true
        }
      ]
    ],
    "branches": [
      "main",
      {
        "name": "next",
        "prerelease": true
      }
    ]
  },
  "homepage": "https://adminforth.dev/docs/tutorial/Adapters/key-value-adapters/#redis-adapter",
  "repository": {
    "type": "git",
    "url": "https://github.com/devforth/adminforth-key-value-adapter-redis.git"
  }
}
